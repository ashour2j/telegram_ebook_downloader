# Telegram API Credentials (Get these from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Target Telegram Channel or Group (Username or link)
TELEGRAM_TARGET_CHAT=@my_ebook_channel

# Output Directory for Downloaded Ebooks
OUTPUT_DIR=./downloads

# Output Filename Formatting Template
# Supported named groups: {title}, {author}, {ext}
OUTPUT_TEMPLATE={title} - {author}.{ext}

# Optional school term filter: 1 = first term (الترم الاول), 2 = second term (الترم الثاني), empty = all terms
FILTER_TERM=
